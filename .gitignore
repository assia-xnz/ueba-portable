# Données (volumineuses / sensibles — non versionnées)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environnements virtuels
.venv/
venv/

# Tests & couverture
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Modèles entraînés (générés, non versionnés)
models/*
!models/.gitkeep
*.joblib

# Variables d'environnement (credentials — NE JAMAIS COMMITTER)
.env

# OS
.DS_Store
