# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer le fichier .env (il est dans .gitignore)

# Elasticsearch (optionnel — pour l'indexation des anomalies détectées)
ES_HOST=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_INDEX_PREFIX=ueba-anomalies

# Pipeline
UEBA_LOOKBACK_DAYS=7
UEBA_WINDOW_HOURS=1
UEBA_STEP_MINUTES=30
UEBA_MIN_OBSERVATIONS=5
